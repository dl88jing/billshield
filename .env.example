# Firebase web app config (public identifiers, not secrets; protect with App Check)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# App Check: reCAPTCHA Enterprise site key for production (Google deprecated v3 onboarding).
# Set DEBUG=true only for local dev. Never commit real keys.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# enterprise (default) or v3
NEXT_PUBLIC_APPCHECK_PROVIDER=enterprise
NEXT_PUBLIC_APPCHECK_DEBUG=false
# Optional cloud model override (default gemini-3.5-flash-lite)
NEXT_PUBLIC_CLOUD_MODEL=
