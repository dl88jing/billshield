# Firebase web app config (public identifiers, not secrets; protect with App Check)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# App Check: reCAPTCHA v3 site key for production; set DEBUG=true only for local dev
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# v3 (default) or enterprise
NEXT_PUBLIC_APPCHECK_PROVIDER=v3
NEXT_PUBLIC_APPCHECK_DEBUG=false
# Optional cloud model override (default gemini-3.5-flash-lite)
NEXT_PUBLIC_CLOUD_MODEL=
